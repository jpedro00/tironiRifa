# =============================================================================
# STAGING — modelo de variáveis
#
# NENHUM VALOR REAL AQUI. Este arquivo descreve QUAIS variáveis existem e onde
# cada uma é usada. Os valores vivem no painel do provedor (Render/Vercel),
# cifrados, e nunca neste repositório.
#
# Staging é ambiente descartável, exposto na internet, com TLS. Não é produção
# e não recebe dado real de pessoa nenhuma.
# =============================================================================

# -----------------------------------------------------------------------------
# ADMINISTRATIVO — usado APENAS por um operador, a partir da máquina dele.
#
# Nunca entra em serviço nenhum do Render. Um processo de execução contínua com
# credencial de dono do schema transforma qualquer falha sua em acesso total.
# -----------------------------------------------------------------------------
# Dono do banco no Neon. Roda bootstrap, migrations e queue:install.
DATABASE_ADMIN_URL=
# O migrador lê esta; aponte para o mesmo valor de DATABASE_ADMIN_URL.
MIGRATION_DATABASE_URL=
# Usada uma vez pelo bootstrap para criar os papéis restritos.
ADMIN_DATABASE_URL=
DATABASE_NAME=campaigns_staging
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
# Instalação do schema da fila (etapa administrativa).
QUEUE_ADMIN_DATABASE_URL=

# -----------------------------------------------------------------------------
# API — serviço web no Render (campaigns-api-staging)
# -----------------------------------------------------------------------------
NODE_ENV=staging
PORT=10000

# Papel RESTRITO app_user. Nunca o dono do schema.
DATABASE_URL=
DATABASE_SSL=true

# 32 bytes em base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder esta chave invalida todos os segundos fatores já cadastrados.
MFA_ENCRYPTION_KEY=

# As três URLs do Vercel, separadas por vírgula. Sem allowlist a API RECUSA
# subir em staging — não existe fallback permissivo.
CORS_ORIGINS=

APP_BASE_DOMAIN=plataforma.local

# Frontends e API ficam em SITES diferentes (vercel.app × onrender.com), logo
# toda chamada é cross-site. `none` é o único valor em que o navegador envia o
# cookie nessa topologia, e exige `Secure` — a configuração recusa a combinação
# insegura. Quem barra escrita de origem desconhecida é o originGuard.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_NAME=campaigns_session
SESSION_TTL_HOURS=12

# Em staging a API nunca vê o hostname da vitrine no `Host` (sites diferentes),
# então a resolução por domínio não tem o que ler. A configuração RECUSA este
# valor em produção, onde o domínio é a única fonte.
TENANT_HEADER_ENABLED=true

# Bloqueio por CONTA.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Limite por ORIGEM, anterior à autenticação. Impede que uma origem tranque
# muitas contas conhecidas. Ver apps/api/src/lib/loginThrottle.ts.
LOGIN_ORIGIN_WINDOW_MINUTES=15
LOGIN_ORIGIN_MAX_FAILURES=20
LOGIN_ORIGIN_MAX_ACCOUNTS=5

MFA_ISSUER=Campanhas e Comunidades (staging)

# -----------------------------------------------------------------------------
# WORKER — background worker no Render (campaigns-worker-staging)
# -----------------------------------------------------------------------------
# Papel app_worker. O nome é próprio para tornar impossível trocar pela
# conexão da API sem perceber.
WORKER_DATABASE_URL=
# Mesmo papel: o schema `pgboss` já pertence a ele (migration 0008).
QUEUE_DATABASE_URL=
QUEUE_SCHEMA=pgboss

OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_SECONDS=5

# -----------------------------------------------------------------------------
# FRONTENDS — projetos no Vercel
#
# Tudo aqui é PÚBLICO: o Vite embute estas variáveis no pacote entregue ao
# navegador. Nenhum segredo, em hipótese alguma.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=
